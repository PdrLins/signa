# Signa back-end (portfolio tracker). The brain's settings (AI keys, budgets,
# Codex, FRED, brain tokens) moved to Signa Advisor; leftover keys in an old
# .env are ignored.

# Supabase — SUPABASE_KEY MUST be the service_role key (server-side only,
# never ship it to the front-end). Every table has RLS on (app/db/schema.sql),
# so the anon key can't read anything; the backend warns at startup if it sees one.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJxxxxx

# Telegram Bot (sign-in codes, two-step sign-in, Premium notifications)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Login second factor. true = password + Telegram code (default).
# false = password only — keep the app on 127.0.0.1 if you turn this off.
LOGIN_OTP_ENABLED=true
# Poll Telegram for bot messages when there is no public webhook (local
# machine). Hosted: set false and register the webhook instead.
# TELEGRAM_POLLING=true
# Telegram Webhook Secret (set when registering webhook)
TELEGRAM_WEBHOOK_SECRET=
# Bot @username without the @, for the "Connect Telegram" links users open
# (t.me/<bot>?start=<code>). Optional: read once from Telegram (getMe) if empty.
TELEGRAM_BOT_USERNAME=
# Per-user Telegram notifications for Premium (migration 016). Default true.
# TELEGRAM_NOTIFICATIONS_ENABLED=true

# Auth (always enforced — there is no AUTH_ENABLED switch)
# JWT_SECRET_KEY is REQUIRED, must be >= 32 chars, and the placeholder below
# is rejected at startup. Generate it with:  openssl rand -hex 32
DEBUG=false
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_GRACE_HOURS=4
JWT_MAX_SESSION_HOURS=24
OTP_EXPIRE_SECONDS=120

# CORS (JSON array of allowed origins). Add your Tailscale/LAN origin if used,
# e.g. ["http://localhost:3000","http://127.0.0.1:3000","https://mac.tailnet.ts.net"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dev tools: lets an owner preview the app as free/premium (web "View as" switch).
# Local development only. Never enable in production.
DEV_TOOLS_ENABLED=false

# Back-end log files (relative to back-end/); empty = stdout only (containers).
# LOG_FILE_DIR=logs

# --- Email sign-in (migration 018) ---
# console = the code is written to the back-end log (development only)
EMAIL_PROVIDER=console
EMAIL_FROM=Signa <no-reply@your-domain.com>
RESEND_API_KEY=
# EMAIL_PROVIDER=smtp works with Amazon SES, Brevo, Postmark, Gmail…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Public "Create account": keep false until Signa is hosted
SIGNUP_ENABLED=false

# --- Referrals / invite-only sign-up (migration 019) ---
# true = sign-up needs an invite code; false = open sign-up (code optional).
# Set false before ads: people who come from an ad have no code.
SIGNUP_INVITE_REQUIRED=true
# true once Premium can be bought in the app (In-App Purchase); false = the
# apps hide every upgrade button (GET /auth/me "premium_on_sale").
PREMIUM_ON_SALE=false
# Public URL of the web app (no trailing slash). Invite links become
# <WEB_APP_URL>/signup?code=<account id>. Optional: share_url is null when empty.
WEB_APP_URL=

# --- iOS push notifications (migration 025) ---
# Apple Developer -> Keys -> a key with "Apple Push Notifications service" (.p8).
# Empty = pushes are only logged (development).
# PUSH_NOTIFICATIONS_ENABLED=true
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=     # the .p8 contents; newlines may be written as \n
APNS_BUNDLE_ID=
