{
  // F5 runs whichever configuration is selected in Run and Debug.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/back-end",
      "python": "${workspaceFolder}/back-end/venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Same API, reachable from an iPhone on the same Wi-Fi at
      // http://<this-mac>.local:8000/api/v1. Plain HTTP: use on a trusted
      // home network only.
      "name": "Backend on Wi-Fi (phone)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}/back-end",
      "python": "${workspaceFolder}/back-end/venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
